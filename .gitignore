# ==============================================================================
# .gitignore — Tienda de Juguetes (Toys Nova)
# ==============================================================================

# --- Archivos de Sistema Operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Archivos y Carpetas de Entorno de Desarrollo / IDEs ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.gemini/
.agents/

# --- Logs y Errores de Servidor Web / PHP ---
*.log
error_log
php_error.log
apache_error.log
xdebug.log

# --- Archivos Temporales de Prueba ---
tmp_*.php
test_*.php
*.tmp
*.bak
*.swp
*.swo

# --- Archivos de Configuración Sensibles / Entorno ---
.env
.env.local
.env.*.local
config.local.php

# --- Dependencias de Paquetes (Node.js & Composer) ---
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Caché del Navegador y Service Worker ---
.cache/
